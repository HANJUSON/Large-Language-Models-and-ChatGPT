# Local agent session and runtime state
.omc/

# Local Python virtual environment
.venv/

# Local secrets and agent/editor settings
.claude/settings.local.json
.env

# Python bytecode
__pycache__/

# Report/demo environment (README 4.2)
.venv-demo/

# Trial common lists built from an unconfirmed review (README 7.1)
data/processed/trial/

# Partial checkpoint writes (model_specs.save_checkpoint writes .tmp, then renames)
runs/*/checkpoint/*.tmp

# train.py: run lock, stage-2 checkpoint staging folder, partial JSON writes (.tmp, then os.replace)
runs/*.lock
runs/*/checkpoint.staging/
runs/**/*.json.tmp

# Reviewer view written by scripts/build_dev_cases.py --view (read-only aid, never committed)
data/cases/*/view/

# EXP-02 review batches with validation text and the review session output (merged into results/s3/error_types.csv, never committed)
data/error_review/view/
