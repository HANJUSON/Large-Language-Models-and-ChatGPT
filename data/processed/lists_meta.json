  "rules": {
    "augmentation": "the cases listed in train_aug.csv of the augmentation folder (sentence_id = case ID, label, text_sha256_12; strictly ascending), text from cases.csv; every listed case has status assigned there with the same label and text hash; no listed case equals a row of the whole original validation or of test at level A (exact key) or B (normalised_key, punct_key), otherwise the build stops (B09); level C (one_word_edit) pairs with the whole original validation and with test are counted only (README 3.2)",
    "exact_key": "raw text field, unchanged (README 3.1)",
    "normalised_key": "NFKC, strip and collapse whitespace, casefold (README 3.1); used for train review groups, the train/validation audit and the similar-sentence check; on test only as a SHA-256 digest inside load_test",
    "punct_key": "normalised key with every Unicode P* (punctuation) and S* (symbol) character replaced by a space, whitespace collapsed; an empty punct key is no key (README 3.2)",
    "sentence_id": "split:NNNNNN = 0-based index of the data records read with Python csv (UTF-8, newline=''), header excluded (README 7.1)",
    "similar_levels": "pairs whose exact keys differ, each at its first level: B normalised_key (normalised keys equal), B punct_key (punct keys equal, normalised keys differ), C one_word_edit (punct-key word sequences differ by one word inserted, deleted or substituted, the shorter has >= 5 words); decided from SHA-256 digests only (README 3.2)",
    "similar_scope": "train_clean internal: a B group (one punct key, >= 2 rows) with >= 2 labels stops the build (B08), otherwise all rows are kept; validation_clean internal and vs every original train row; test_clean_preaug internal (B only) and vs every original train row and the whole original validation; cross-split pairs are counted and listed, never excluded; similar_pairs.csv lists every B and C pair except test C pairs (counted only)",
    "test_audit": "the lists and the audit compare test by exact key only (SHA-256 digests); the similar block compares test_clean_preaug by digests of the normalised key, the punct key and its one-word deletions (no test text is kept)",
    "test_clean": "final list at the augmentation freeze: test minus rows whose exact key is in the cleaned train, the augmentation cases or the whole original validation (README 3.2 DATA-05); one primary reason per row by precedence train_overlap > augmentation_overlap > validation_overlap; no augmentation case equals a test row (B09), so the rows are those of test_clean_preaug and its similar-sentence statistics apply",
    "test_clean_preaug": "test minus rows whose exact key is in the cleaned train, the augmentation cases (none before the augmentation freeze) or the whole original validation (README 3.2 DATA-05); one primary reason per row by precedence train_overlap > augmentation_overlap > validation_overlap",
    "text_sha256_12": "first 12 lowercase hex characters of SHA-256 of the raw text field in UTF-8",
    "train_clean": "drop review rows with decision exclude, then keep the lowest sentence ID of every exact-key group (README 3.2)",
    "validation_clean": "original validation minus rows whose exact key is in the original train (README 3.1)"
  },
