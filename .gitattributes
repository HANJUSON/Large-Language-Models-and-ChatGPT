# Keep downloaded raw datasets byte-identical to their source (no CRLF/LF conversion),
# so the hashes in each download_manifest.json stay valid on every computer.
datasets/** -text

# Keep requirements.txt LF on every checkout so the SHA-256 recorded at freeze-1 is reproducible.
requirements.txt text eol=lf

# Keep requirements-demo.txt LF too, for consistent bytes across checkouts.
requirements-demo.txt text eol=lf

# Keep processed common lists, review records and their metadata LF so their SHA-256 at freeze-1 is reproducible.
data/processed/**/*.csv text eol=lf
data/processed/**/*.json text eol=lf

# Store each run's selected checkpoint with Git LFS (README 7.1: only files under runs/*/checkpoint/).
runs/*/checkpoint/** filter=lfs diff=lfs merge=lfs -text

# Keep run records LF on every checkout so their bytes and SHA-256 are reproducible.
runs/**/*.csv text eol=lf
runs/**/*.json text eol=lf

# Keep training/evaluation configs LF so the config SHA-256 recorded in each run is reproducible.
configs/** text eol=lf

# Keep stage results LF so their bytes are the same on every checkout (scripts/summarize_s2.py output).
results/** text eol=lf

# Keep evaluation and augmentation case files LF so build_dev_cases.py --check and their SHA-256 are the same on every checkout.
data/cases/**/*.csv text eol=lf
data/cases/**/*.json text eol=lf
data/cases/**/*.md text eol=lf

# Keep the EXP-02 review prompt LF like the other review records.
data/error_review/**/*.md text eol=lf
data/error_review/**/*.csv text eol=lf

# Keep downloaded external evaluation datasets and their records byte-identical (hashes in download_manifest.json and external_rules.json).
data/external/** -text

# Keep the freeze records LF so their bytes are the same on every checkout (scripts/make_freeze.py).
freeze/** text eol=lf
