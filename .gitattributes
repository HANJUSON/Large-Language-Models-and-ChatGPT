# Keep downloaded raw datasets byte-identical to their source (no CRLF/LF conversion),
# so the hashes in each download_manifest.json stay valid on every computer.
datasets/** -text

# Keep requirements.txt LF on every checkout so the SHA-256 recorded at freeze-1 is reproducible.
requirements.txt text eol=lf

# Keep requirements-demo.txt LF too, for consistent bytes across checkouts.
requirements-demo.txt text eol=lf

# Keep processed common lists, review records and their metadata LF so their SHA-256 at freeze-1 is reproducible.
data/processed/**/*.csv text eol=lf
data/processed/**/*.json text eol=lf
